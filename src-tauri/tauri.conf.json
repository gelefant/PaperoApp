{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Papero",
  "version": "0.5.2",
  "identifier": "org.papero.app",
  "build": {
    "beforeDevCommand": {
      "script": "npm run dev",
      "cwd": "../frontend"
    },
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": {
      "script": "npm run build",
      "cwd": "../frontend"
    },
    "frontendDist": "../frontend/dist"
  },
  "app": {
    "windows": [
      {
        "title": "Papero",
        "width": 1280,
        "height": 840
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "resources": [
      "resources/"
    ],
    "license": "MIT OR Apache-2.0",
    "category": "Reference",
    "shortDescription": "Zero-cost local PDF/DjVu mathematical cataloger & semantic search",
    "linux": {
      "deb": {
        "depends": [
          "djvulibre-bin"
        ]
      }
    },
    "macOS": {
      "minimumSystemVersion": "10.15"
    }
  }
}
